# WOHLverde | Server-Einstellungen (All-Inkl, Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

RewriteEngine On

# Test ueber die Uebergangsadresse des Hosters: keine Umleitung (muss ganz oben bleiben)
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# Immer https und ohne www (bisherige Adresse war https://wohlverde.de)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://wohlverde.de%{REQUEST_URI} [R=301,L]

# Alte WordPress-Adressen (ohne Schraegstrich) sauber weiterleiten
RewriteRule ^(garten-und-landschaftspflege|gebaeudereinigung|hausmeister-service|kontakt|impressum|datenschutz|hinweis-zur-gleichstellung)$ /$1/ [R=301,L]
RewriteRule ^test/?$ / [R=301,L]
RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [R=301,L,NC]
RewriteRule ^aoc-login/?$ / [R=301,L,NC]
RewriteRule ^feed/?$ / [R=301,L]

# Sicherheit
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Zwischenspeicher: HTML nie, CSS/JS einen Tag, Bilder und Schriften ein Jahr
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType text/plain .txt

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml application/manifest+json
</IfModule>
